{
  "name": "dsh-server-manager",
  "version": "1.0.6",
  "description": "Multi-server operations for DeepSeek Harness: live status, password/key/SSH-agent login, agent-callable exec, file transfer, release deploys and rollbacks, plus read-only QNAP, Synology and fnOS NAS monitoring over their web UIs.",
  "type": "module",
  "license": "MIT",
  "author": "dsh-server-manager contributors",
  "icon": "icon.png",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "client",
    "docs",
    "examples",
    "icon.png",
    "screenshots.json",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "ssh",
    "server",
    "devops",
    "deploy",
    "sftp",
    "remote"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "test:in-process": "node --test --test-isolation=none",
    "check": "node --check src/index.js && node --check client/client.js",
    "build:vendor": "node scripts/build-vendor.mjs",
    "prepack": "npm run build:vendor"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "ssh2": "1.17.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.5": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/demo-user-qq/dsh-server-manager.git"
  },
  "homepage": "https://github.com/demo-user-qq/dsh-server-manager#readme",
  "bugs": {
    "url": "https://github.com/demo-user-qq/dsh-server-manager/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
