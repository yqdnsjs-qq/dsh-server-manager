{
  "$comment": "Example only. The real file lives in $DSH_HOME/server-manager/servers.json and is never committed.",
  "version": 1,
  "defaults": {
    "port": 22,
    "username": "root",
    "connectTimeoutMs": 10000,
    "commandTimeoutMs": 60000,
    "maxOutputBytes": 524288,
    "hostKeyPolicy": "accept-new"
  },
  "servers": [
    {
      "id": "prod-web",
      "name": "Production web",
      "host": "203.0.113.10",
      "port": 22,
      "username": "deploy",
      "auth": "key",
      "privateKeyPath": "~/.ssh/id_ed25519",
      "group": "prod",
      "tags": ["web", "nginx"],
      "notes": "behind the CDN; deploy user has no general sudo",
      "policy": {
        "readOnly": false,
        "allowDangerous": false,
        "allowCommands": [],
        "denyCommands": ["\\breboot\\b"]
      },
      "hostKey": {
        "policy": "accept-new",
        "fingerprint": null
      }
    },
    {
      "id": "staging",
      "name": "Staging",
      "host": "10.0.0.15",
      "username": "ubuntu",
      "auth": "password",
      "password": "env:STAGING_SSH_PASSWORD",
      "group": "staging",
      "policy": {
        "readOnly": false,
        "allowDangerous": true
      }
    },
    {
      "id": "nas-01",
      "name": "QNAP TS-453 Pro",
      "host": "192.0.2.28",
      "port": 88,
      "transport": "qnap",
      "baseUrl": "http://192.0.2.28:88",
      "username": "admin",
      "auth": "password",
      "password": "vault:nas-01.password",
      "group": "NAS",
      "tags": ["qnap", "nas"],
      "notes": "QTS web login, read-only; Container Station control is not exposed"
    },
    {
      "id": "prod-db",
      "name": "Production database",
      "host": "10.0.0.20",
      "username": "ops",
      "auth": "key",
      "privateKeyPath": "~/.ssh/id_ed25519",
      "group": "prod",
      "notes": "read-only for agents",
      "policy": {
        "readOnly": true
      }
    }
  ]
}
